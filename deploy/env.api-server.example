# Copy to deploy/.env.api-server (gitignored). Used by:
#   deploy/deploy-api-shared-mysql.sh
#   docker compose -f docker-compose.shared-mysql-api-only.yml --env-file deploy/.env.api-server
#   deploy/import-local-db-to-remote-db.sh (reads REMOTE_MYSQL_ROOT_PASSWORD from here)
#
#   cp deploy/env.api-server.example deploy/.env.api-server

NODE_ENV=production

# --- MySQL (shared Docker container `db`, same Compose network as API) ---
EXTERNAL_MYSQL_DOCKER_NETWORK=projects_default
DB_HOST=db
DB_PORT=3306
DB_USER=intellinex_hmis_user
DB_PASSWORD=
DB_NAME=intellinex_hmis_db

# Remote MySQL root (import script only; not used by the API process)
# REMOTE_MYSQL_ROOT_PASSWORD=

JWT_SECRET=

# Zoom Meeting SDK (telemedicine signatures) — from Zoom Marketplace app credentials
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# CORS: exact Origin browsers send (scheme + host, NO path). Must match your static site.
# Example static site: https://lau.lambdahoster.com/hmis → use:
FRONTEND_URL=https://lau.lambdahoster.com

PORT=3001
API_BASE_URL=http://kiplombe_api:3001

# Not used inside the API container; documented for parity with root .env
# NEXT_PUBLIC_API_URL=
